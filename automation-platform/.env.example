# Copy this file to `.env` and adjust as needed. `.env` is git-ignored.
#
# The application needs no configuration: the workspace is whatever folder you
# select, and its database lives inside that folder. There is no environment
# variable for the workspace path on purpose — it is chosen at runtime and
# remembered in the application preferences. The entries below are the ones the
# tooling actually reads.

# Host to bind the Vite dev server to, used by `npm run tauri dev` when
# developing against a device on the same network. Leave unset for normal
# desktop development.
# TAURI_DEV_HOST=192.168.1.10

# Vite only exposes variables prefixed with VITE_ to the frontend.
# VITE_APP_NAME=Automation Platform
